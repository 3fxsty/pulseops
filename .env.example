# Copy to .env and replace every change-me value. .env is never committed.
# Use URL-safe passwords (letters, digits, - and _): they are embedded in URLs.
# Values can reference earlier ones with ${VAR}.

# --- Secrets (required by Docker Compose) ---
POSTGRES_SUPERUSER_PASSWORD=change-me-superuser
PULSEOPS_OWNER_PASSWORD=change-me-owner
PULSEOPS_APP_PASSWORD=change-me-app
VALKEY_PASSWORD=change-me-valkey
# API key for the X-API-Key header: at least 32 characters. The placeholder is
# deliberately too short, so the API refuses to start until it is replaced.
# Generate one with: openssl rand -base64 32
API_KEY=change-me

# --- App settings ---
# SSRF protection: set to true only for installs that must check private networks.
ALLOW_PRIVATE_TARGETS=false
# Serve Swagger UI (/docs), ReDoc and /openapi.json.
DOCS_ENABLED=true

# --- Running on the host (tests, alembic) ---
# Inside Docker Compose these are built from the secrets above and point at the
# service names instead of localhost.
DATABASE_URL=postgresql+asyncpg://pulseops_app:${PULSEOPS_APP_PASSWORD}@localhost:5432/pulseops
MIGRATION_DATABASE_URL=postgresql+asyncpg://pulseops_owner:${PULSEOPS_OWNER_PASSWORD}@localhost:5432/pulseops
# Valkey is not published outside Docker; this is only a placeholder for the host.
BROKER_URL=redis://:${VALKEY_PASSWORD}@localhost:6379/0

# Separate database for tests: they never touch development data.
TEST_DATABASE_URL=postgresql+asyncpg://pulseops_app:${PULSEOPS_APP_PASSWORD}@localhost:5432/pulseops_test
TEST_MIGRATION_DATABASE_URL=postgresql+asyncpg://pulseops_owner:${PULSEOPS_OWNER_PASSWORD}@localhost:5432/pulseops_test
