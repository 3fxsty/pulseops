# Copy to .env and adjust. Docker Compose reads it automatically;
# every value has a default, so .env is optional for local development.

POSTGRES_USER=pulseops
POSTGRES_PASSWORD=change-me
POSTGRES_DB=pulseops

# Used when running the app outside Docker (inside Compose they point at the
# service names instead of localhost).
DATABASE_URL=postgresql://pulseops:change-me@localhost:5432/pulseops
BROKER_URL=redis://localhost:6379/0
